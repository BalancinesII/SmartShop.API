<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.14" />
    <PackageReference Include="Stripe.net" Version="47.4.0" />
    <!-- Used directly by JwtService. Pinned to the same Microsoft.IdentityModel
         version that Microsoft.AspNetCore.Authentication.JwtBearer 10 depends on. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <!-- Not used directly. Microsoft.Data.SqlClient (via EF Core SqlServer) pulls
         System.Security.Cryptography.Pkcs 9.0.11, which has known vulnerabilities
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). No SqlClient version compatible
         with EF Core 10 depends on a patched one yet, so pin it here. Remove once
         EF Core ships with a SqlClient that requires a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartShop.Domain\SmartShop.Domain.csproj" />
  </ItemGroup>

</Project>
